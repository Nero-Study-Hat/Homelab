// Example/default ACLs for unrestricted connections.
{
	// Declare static groups of users. Use autogroups for all users or users with a specific role.
	"groups": {
		"group:personal": ["redacted@github"],
		"group:family":   ["redacted@outlook.com"],
		"group:outside":  ["redacted@outlook.com"],
	},

	"hosts": {
		"cloud-traefik-net": "172.20.0.0/29",
		"cloud-dns-net": "172.20.1.0/29",
		"cloud-monitor-center-net": "172.20.20.0/29",

		"cloud-traefik": "172.20.0.2",
		"cloud-dns": "172.20.1.2",
		
		"media-traefik-net": "172.22.0.0/29",
		"media-dns-net": "172.22.1.0/29",
		"media-monitor-outpost-net": "172.22.21.0/29",

		"media-traefik": "172.22.0.2",
		"media-traefik-monitor-outpost": "172.22.21.4",
		"media-dns": "172.22.1.2",
	},

	// Define the tags which can be applied to devices and by which users.
	"tagOwners": {
		"tag:ssh-server":        ["redacted@github"],
		"tag:cloud-gate-server": ["redacted@github"],

		"tag:cloud-server": ["redacted@github"],
		"tag:fog-server":   ["redacted@github"],
		"tag:media-server": ["redacted@github"],

		"tag:redacted-client":   ["redacted@outlook.com"],
	},

	"autoApprovers": {
		"routes": {
			"172.20.0.0/29": ["tag:cloud-server"], // traefik
			"172.20.1.0/29": ["tag:cloud-server"], // dns
			"172.20.20.0/29": ["tag:cloud-server"], // monitor-center

			"172.22.0.0/29": ["tag:media-server"], // traefik
			"172.22.1.0/29": ["tag:media-server"], // dns
			"172.22.21.0/29": ["tag:media-server"], // monitor-outpost
		},
	},

	// Define postures that will be applied to all rules without any specific
	// srcPosture definition.
	// "defaultSrcPosture": [
	//      "posture:anyMac",
	// ],

	// Define device posture rules requiring devices to meet
	// certain criteria to access parts of your system.
	// "postures": {
	//      // Require devices running macOS, a stable Tailscale
	//      // version and auto update enabled for Tailscale.
	//  "posture:autoUpdateMac": [
	//      "node:os == 'macos'",
	//      "node:tsReleaseTrack == 'stable'",
	//      "node:tsAutoUpdate",
	//  ],
	//      // Require devices running macOS and a stable
	//      // Tailscale version.
	//  "posture:anyMac": [
	//      "node:os == 'macos'",
	//      "node:tsReleaseTrack == 'stable'",
	//  ],
	// },

	// Define users and devices that can use Tailscale SSH.
	"ssh": [
		{
			"action": "accept", // "accept" or "check"
			"src":    ["group:personal"],
			"dst":    ["tag:ssh-server"],
			"users":  ["autogroup:nonroot", "root"],

			// "checkPeriod": "20h", // optional, only for check actions. default 12h
		},

		// Allow all users to SSH into their own devices in check mode.
		// Comment this section out if you want to define specific restrictions.
		// {
		//  "action": "check",
		//  "src":    ["autogroup:member"],
		//  "dst":    ["autogroup:self"],
		//  "users":  ["autogroup:nonroot", "root"],
		// },
	],

	// Test access rules every time they're saved.
	// "tests": [
	//   {
	//       "src": "alice@example.com",
	//       "accept": ["tag:example"],
	//       "deny": ["100.101.102.103:443"],
	//   },
	// ],

	"randomizeClientPort": true,

	"nodeAttrs": [
		{
			"target": ["tag:ssh-server"],
			"ipPool": ["100.80.0.0/29"],
		},
		{
			"target": ["tag:cloud-gate-server"],
			"ipPool": ["100.80.1.1/32"],
		},
		{
			"target": ["tag:cloud-server"],
			"ipPool": ["100.70.0.1/32"],
		},
		{
			"target": ["tag:fog-server"],
			"ipPool": ["100.70.0.2/32"],
		},
		{
			"target": ["tag:media-server"],
			"ipPool": ["100.70.0.3/32"],
		},
	],

	"grants": [
		{
			"src": ["group:personal"],
			"dst": ["tag:ssh-server"],
			"ip":  ["22"],
		},

		// {
		// 	"src": [],
		// 	"dst": [],
		// 	"ip":  [],
		// },

		// https://ubiq.co/tech-blog/how-to-whitelist-ip-in-nginx/
		// keep current account setup for easy viewing of
		// what machines are outside in tailscale web ui
		// {
		// 	"src": ["group:clients"],
		// 	"dst": ["nginx"],
		// 	"ip":  ["tcp:443"],
		// },
		// {
		// 	"src": ["group:clients", "nginx"],
		// 	"dst": ["client-dns"],
		// 	"ip":  ["tcp:443"],
		// },

		{
			"src": [
				"group:personal",
				"tag:redacted-client",
			],
			"dst": ["tag:cloud-gate-server"],
			"ip":  ["udp:53"],
		},

		// {
		// 	"src": [
		// 		"group:personal",
		// 		"tag:redacted-client",
		// 	],
		// 	"dst": ["tag:cloud-gate-server"],
		// 	// "ip":  ["tcp:443"],
		// 	// "ip": ["tcp:80", "tcp:443"], // required for staging testing
		// 	"ip": ["*"],
		// },

		{
			"src": ["tag:cloud-gate-server"],
			"dst": ["cloud-traefik", "media-traefik"],
			// "ip":  ["tcp:443"],
			"ip": ["tcp:80", "tcp:443"], // required for staging testing
		},

		{
			"src": [
				"cloud-traefik-net",
				"cloud-dns-net",
				"cloud-monitor-center-net",
			],
			"dst": ["cloud-dns"],
			"ip":  ["udp:53"],
		},

		{
			"src": [
				"media-traefik-net",
				"media-dns-net",
				"media-monitor-outpost-net",
			],
			"dst": ["media-dns"],
			"ip":  ["udp:53"],
		},

		// {
		// 	"src": ["group:personal", "tag:redacted-client"],
		// 	"dst": ["traefik-cloud", "traefik-fog", "traefik-media"],
		// 	// "ip":  ["tcp:443"],
		// 	"ip": ["tcp:80", "tcp:443"], // required for staging testing
		// },

		// {
		// 	"src": ["tag:example-client"],
		// 	"dst": ["traefik-cloud", "traefik-media"],
		// 	"ip":  ["tcp:443"],
		// },
	],
}
