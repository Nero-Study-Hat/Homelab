### MONITOR OUTPOST ###

monitor_outpost:
  name: "monitor_outpost"
  network_backend:
    name: "monitor_outpost"
    ipam_options:
    - subnet: "10.130.20.0/29"
      gateway: "10.130.20.1"
    traefik_ips:
      traefik: "10.130.20.2"
      tailscale_traefik: "10.130.20.3"
      tailscale_alloy: "10.130.20.4"
      cadvisor: "10.130.20.5"
      dns: "10.130.20.6"
  outpost_header: "night-outpost"
  traefik_scrape_addresses:
    # don't use tailscale addresses here
    - "10.130.0.3" # network center 
    - "10.130.20.4" # monitor outpost
  tailscale_scrape_addresses:
    - "100.70.0.3" # night server - network center
    - "100.80.20.4" # night server - monitor outpost traefik
    - "100.80.20.5" # night server - monitor outpost alloy
  domains:
    main: "night.wiresndreams.dev"
    wildcard: "*.monitor.night.wiresndreams.dev"
    traefik: "traefik.monitor.night.wiresndreams.dev"
    loki: "loki.monitor.night.wiresndreams.dev"
    loki_forward: "loki.dusk.wiresndreams.dev"
    mimir: "mimir.monitor.night.wiresndreams.dev"
    mimir_forward: "mimir.dusk.wiresndreams.dev"
  dns:
    upstream_server: "10.0.0.3"
    config: |
      address=/monitor.day.wiresndreams.dev/10.110.20.3

